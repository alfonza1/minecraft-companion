{
  "name": "minecraft-companion",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Waypoint: an open-source AI gaming companion platform, starting with Minecraft Survival",
  "bin": {
    "mineness": "src/server.js"
  },
  "scripts": {
    "upstream:mcp": "node src/server.js",
    "start": "node services/api/index.js",
    "dev": "node services/api/index.js",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "build": "vite build --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/dashboard/tsconfig.json && tsc --noEmit -p apps/website/tsconfig.json",
    "health": "node scripts/health.mjs",
    "setup:native": "node scripts/setup-native.mjs",
    "bootstrap": "powershell -NoProfile -File scripts/Bootstrap.ps1",
    "test": "node --test test/*.test.js",
    "server": "bash mc-server/start.sh",
    "setup": "node scripts/setup.mjs",
    "play": "node scripts/play.mjs",
    "skins": "node scripts/skins.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test:game:upstream": "node scripts/test-game.mjs",
    "test:game": "node scripts/test-companion-game.mjs",
    "install:agent": "node scripts/install.mjs",
    "check:install": "node scripts/install.mjs --check",
    "build:website": "node scripts/build-website.mjs",
    "dev:website": "vite --config apps/website/vite.config.ts",
    "test:website": "node apps/website/tests/site.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "release:check": "node scripts/release-audit.mjs",
    "release:package": "node scripts/package-release.mjs",
    "setup:claude": "node scripts/setup-claude.mjs",
    "test:workspace": "node apps/dashboard/tests/workspace.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "fastify": "5.12.7",
    "lucide-react": "^0.468.0",
    "minecraft-assets": "1.19.0",
    "minecraft-data": "3.117.0",
    "minecraft-protocol": "1.68.0",
    "mineflayer": "4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.2",
    "mineflayer-tool": "^1.2.0",
    "prismarine-auth": "3.1.1",
    "prismarine-nbt": "^2.7.0",
    "prismarine-realms": "1.6.0",
    "prismarine-schematic": "1.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "vec3": "^0.1.8",
    "yargs": "^18.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "flying-squid": "^1.12.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "license": "Apache-2.0"
}
