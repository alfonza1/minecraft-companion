# Optional per-process environment; no credentials belong here.
# Defaults to 127.0.0.1:4365, cannot bind publicly through configuration.
COMPANION_PORT=4365
# Optional external private app data location. Never set this inside Git.
# COMPANION_DATA_DIR=C:\Users\YOUR_NAME\AppData\Local\MinecraftCompanion
# Diagnostic fallback only: disable the pinned native 26.3 adapter.
# COMPANION_NATIVE_PROTOCOL=off
